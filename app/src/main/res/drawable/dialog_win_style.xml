<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item  android:left="2dp"  android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/deep_grey"/> <!-- 设置阴影的颜色 -->
            <corners android:radius="6dp"/> <!-- 设置圆角半径 -->
        </shape>
    </item>
    <item android:bottom="4dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/lightWhite"/> <!-- 设置形状的背景颜色 -->
            <corners android:radius="6dp"/> <!-- 设置圆角半径 -->
        </shape>
    </item>

</layer-list>



